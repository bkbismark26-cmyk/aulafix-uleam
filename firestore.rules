rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* =====================================================
       FUNCIONES GENERALES
    ===================================================== */

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      );
    }

    function role() {
      return signedIn()
        ? userDoc().data.rol
        : null;
    }

    function isAdmin() {
      return role() == "administrador";
    }

    function isTecnico() {
      return role() == "tecnico";
    }

    function isUsuario() {
      return role() == "usuario";
    }

    function reporteDoc(reporteId) {
      return get(
        /databases/$(database)/documents/reportes/$(reporteId)
      );
    }

    function usuarioDestino(uid) {
      return get(
        /databases/$(database)/documents/usuarios/$(uid)
      );
    }


    /* =====================================================
       USUARIOS
    ===================================================== */

    match /usuarios/{uid} {

      /* Registro de usuario normal */

      allow create: if signedIn()

        && request.auth.uid == uid

        && request.resource.data.uid == uid

        && request.resource.data.rol == "usuario"

        && request.resource.data.activo == true;


      /* Lectura */

      allow read: if signedIn() && (

        request.auth.uid == uid

        ||

        isAdmin()

        ||

        resource.data.rol == "administrador"
      );


      /* Administrador puede gestionar usuarios */

      allow update: if signedIn() && (

        isAdmin()

        ||

        (
          request.auth.uid == uid

          && request.resource.data.uid
             == resource.data.uid

          && request.resource.data.rol
             == resource.data.rol

          && request.resource.data.activo
             == resource.data.activo

          && request.resource.data
               .diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 "nombre",
                 "email"
               ])
        )
      );


      allow delete: if false;
    }


    /* =====================================================
       CONTADORES DE TICKETS
    ===================================================== */

    match /contadores/{id} {

      /*
        Solo los usuarios normales necesitan
        generar tickets al crear reportes.
      */

      allow read: if signedIn()
        && isUsuario();


      /*
        Primer ticket del contador.
      */

      allow create: if signedIn()

        && isUsuario()

        && request.resource.data.anio is int

        && request.resource.data.secuencia is int

        && request.resource.data.secuencia == 1;


      /*
        Solo puede incrementar exactamente +1.
      */

      allow update: if signedIn()

        && isUsuario()

        && request.resource.data.anio
           == resource.data.anio

        && request.resource.data.secuencia is int

        && request.resource.data.secuencia
           == resource.data.secuencia + 1

        && request.resource.data
             .diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "secuencia",
               "actualizado_en"
             ]);


      allow delete: if false;
    }


    /* =====================================================
       REPORTES
    ===================================================== */

    match /reportes/{id} {

      /* -----------------------------------------------------
         CREAR REPORTE
      ----------------------------------------------------- */

      allow create: if signedIn()

        && isUsuario()

        && request.resource.data.creado_por
           == request.auth.uid

        && request.resource.data.estado
           == "pendiente"

        && request.resource.data.tecnico_id
           == null

        && request.resource.data.tecnico_nombre
           == null

        && request.resource.data.ticket
           is string

        && request.resource.data.sla_horas
           is int

        && request.resource.data.sla_horas > 0;


      /* -----------------------------------------------------
         LEER REPORTE
      ----------------------------------------------------- */

      allow read: if signedIn() && (

        isAdmin()

        ||

        resource.data.creado_por
          == request.auth.uid

        ||

        resource.data.tecnico_id
          == request.auth.uid
      );


      /* -----------------------------------------------------
         ADMINISTRADOR
      ----------------------------------------------------- */

      allow update: if signedIn()
        && isAdmin();


      /* -----------------------------------------------------
         TÉCNICO:
         ASIGNADO → EN_PROCESO
      ----------------------------------------------------- */

      allow update: if signedIn()

        && isTecnico()

        && resource.data.tecnico_id
           == request.auth.uid

        && resource.data.estado
           == "asignado"

        && request.resource.data.estado
           == "en_proceso"

        && request.resource.data
             .diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "estado",
               "historial",
               "actualizado_en"
             ]);


      /* -----------------------------------------------------
         TÉCNICO:
         EN_PROCESO → SOLUCIONADO
      ----------------------------------------------------- */

      allow update: if signedIn()

        && isTecnico()

        && resource.data.tecnico_id
           == request.auth.uid

        && resource.data.estado
           == "en_proceso"

        && request.resource.data.estado
           == "solucionado"

        && request.resource.data
             .diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "estado",
               "historial",
               "actualizado_en",
               "evidencia_final_url"
             ]);


      /* -----------------------------------------------------
         TÉCNICO:
         AGREGAR COMENTARIO
      ----------------------------------------------------- */

      allow update: if signedIn()

        && isTecnico()

        && resource.data.tecnico_id
           == request.auth.uid

        && request.resource.data.estado
           == resource.data.estado

        && request.resource.data
             .diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "comentarios",
               "actualizado_en"
             ]);


      /* -----------------------------------------------------
         USUARIO:
         AGREGAR COMENTARIO
      ----------------------------------------------------- */

      allow update: if signedIn()

        && isUsuario()

        && resource.data.creado_por
           == request.auth.uid

        && request.resource.data.estado
           == resource.data.estado

        && request.resource.data.tecnico_id
           == resource.data.tecnico_id

        && request.resource.data.ticket
           == resource.data.ticket

        && request.resource.data.prioridad
           == resource.data.prioridad

        && request.resource.data
             .diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "comentarios",
               "actualizado_en"
             ]);


      allow delete: if false;
    }


    /* =====================================================
       NOTIFICACIONES
    ===================================================== */

    match /notificaciones/{id} {

      /* -----------------------------------------------------
         VALIDACIÓN BÁSICA ADMIN
      ----------------------------------------------------- */

      allow create: if signedIn()

        && isAdmin()

        && request.resource.data.usuario_id
           is string

        && request.resource.data.titulo
           is string

        && request.resource.data.mensaje
           is string

        && request.resource.data.tipo
           is string

        && request.resource.data.leida
           == false;


      /* -----------------------------------------------------
         TÉCNICO

         Solo puede crear notificaciones relacionadas
         con un reporte que realmente tiene asignado.

         Destino permitido:
         - creador del reporte
         - administrador
      ----------------------------------------------------- */

      allow create: if signedIn()

        && isTecnico()

        && request.resource.data.usuario_id
           is string

        && request.resource.data.reporte_id
           is string

        && request.resource.data.titulo
           is string

        && request.resource.data.mensaje
           is string

        && request.resource.data.tipo
           is string

        && request.resource.data.leida
           == false

        && reporteDoc(
             request.resource.data.reporte_id
           ).data.tecnico_id
           == request.auth.uid

        && (

          request.resource.data.usuario_id
            ==
          reporteDoc(
            request.resource.data.reporte_id
          ).data.creado_por

          ||

          usuarioDestino(
            request.resource.data.usuario_id
          ).data.rol
            == "administrador"
        );


      /* -----------------------------------------------------
         USUARIO

         Solo puede notificar a administradores
         sobre un reporte que realmente le pertenece.
      ----------------------------------------------------- */

      allow create: if signedIn()

        && isUsuario()

        && request.resource.data.usuario_id
           is string

        && request.resource.data.reporte_id
           is string

        && request.resource.data.titulo
           is string

        && request.resource.data.mensaje
           is string

        && request.resource.data.tipo
           is string

        && request.resource.data.leida
           == false

        && reporteDoc(
             request.resource.data.reporte_id
           ).data.creado_por
           == request.auth.uid

        && usuarioDestino(
             request.resource.data.usuario_id
           ).data.rol
           == "administrador";


      /* -----------------------------------------------------
         LEER NOTIFICACIONES
      ----------------------------------------------------- */

      allow read: if signedIn()

        && resource.data.usuario_id
           == request.auth.uid;


      /* -----------------------------------------------------
         MARCAR COMO LEÍDA

         Únicamente puede cambiar el campo "leida".
      ----------------------------------------------------- */

      allow update: if signedIn()

        && resource.data.usuario_id
           == request.auth.uid

        && request.resource.data.usuario_id
           == resource.data.usuario_id

        && request.resource.data
             .diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "leida"
             ]);


      allow delete: if false;
    }
  }
}